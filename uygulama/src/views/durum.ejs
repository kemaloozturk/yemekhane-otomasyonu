<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Yemekhane Otomasyonu</title>
  <link rel="stylesheet" href="/css/temel.css">
</head>
<body>
  <main class="kapsayici">
    <h1>Yemekhane Otomasyonu</h1>
    <p>Uygulama çalışıyor.</p>
    <% if (hata) { %>
      <p>Veritabanı hatası: <%= hata %></p>
    <% } else { %>
      <p>Kaynak (yazma) sunucuda kullanıcı sayısı: <strong><%= kaynak %></strong></p>
      <p>Replika (okuma) sunucuda kullanıcı sayısı: <strong><%= replika %></strong></p>
    <% } %>
  </main>
</body>
</html>
