<%- include('../partials/header', { baslik: 'Haftalık Menü & Rezervasyon' }) %>

<div class="filtre-cubugu">
  <form action="/menu/haftalik" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; width: 100%;">
    <div style="flex: 1;">
      <label for="yemekhane_id">Yemekhane Seçin</label>
      <select id="yemekhane_id" name="yemekhane_id" onchange="this.form.submit()">
        <% yemekhaneler.forEach(y => { %>
          <option value="<%= y.id %>" <%= Number(secilenYemekhaneId) === Number(y.id) ? 'selected' : '' %>>
            <%= y.ad %> (Kapasite: <%= y.kapasite %>)
          </option>
        <% }); %>
      </select>
    </div>
    <div>
      <noscript><button type="submit" class="dugme">Göster</button></noscript>
    </div>
  </form>
</div>

<% if (menuler && menuler.length > 0) { %>
  <div class="tablo-kaydir">
    <table>
      <thead>
        <tr>
          <th>Tarih</th>
          <th>Öğün</th>
          <th>Menü Özeti</th>
          <th>Boş Yer</th>
          <th>Ücret</th>
          <th>İşlem</th>
        </tr>
      </thead>
      <tbody>
        <% menuler.forEach(m => { %>
          <% const rezerveDurumu = aktifMenuIdleri[m.menu_id]; %>
          <% const kullaniciUcret = m.kullanici_fiyati; %>
          <tr>
            <td>
              <strong><%= m.tarih %></strong>
              <div style="font-size: 0.75rem; color: var(--metin-soluk);">Son Saat: <%= m.rezervasyon_son.slice(11, 16) %></div>
            </td>
            <td>
              <span class="rozet" style="background: var(--zemin);"><%= m.ogun %></span>
            </td>
            <td>
              <% if (m.yemekler && m.yemekler.length > 0) { %>
                <span style="font-size: 0.9rem;"><%= m.yemekler.map(y => y.ad).join(', ') %></span>
              <% } else { %>
                <span style="color: var(--metin-soluk);">Menü belirleniyor</span>
              <% } %>
            </td>
            <td>
              <strong><%= m.bos_yer %></strong> / <%= m.kapasite %>
              <div style="font-size: 0.75rem; color: var(--metin-soluk);">%<%= m.doluluk_yuzde %> dolu</div>
            </td>
            <td>
              <strong style="color: var(--ana);">₺<%= Number(kullaniciUcret).toFixed(2) %></strong>
              <% if (!locals.kullanici) { %><small>(Öğr.)</small><% } %>
            </td>
            <td style="min-width: 140px;">
              <% if (rezerveDurumu) { %>
                <span class="rozet rozet-<%= rezerveDurumu === 'aktif' ? 'aktif' : 'kullanildi' %>">
                  ✓ <%= rezerveDurumu === 'aktif' ? 'Rezerve Edildi' : 'Kullanıldı' %>
                </span>
              <% } else if (m.gecmis) { %>
                <button type="button" class="dugme dugme-kucuk" disabled aria-disabled="true">Süre Doldu</button>
              <% } else if (m.bos_yer <= 0) { %>
                <button type="button" class="dugme dugme-kucuk" disabled aria-disabled="true">Dolu</button>
              <% } else if (locals.kullanici) { %>
                <form action="/rezervasyon/yap" method="POST" style="margin: 0; display: flex; flex-direction: column; gap: 0.25rem;">
                  <input type="hidden" name="menu_id" value="<%= m.menu_id %>">
                  <input type="hidden" name="donus_url" value="/menu/haftalik?yemekhane_id=<%= secilenYemekhaneId %>">
                  <% if (m.yarim_porsiyon_secilebilir) { %>
                    <label style="font-size: 0.75rem; margin: 0; font-weight: normal; cursor: pointer;">
                      <input type="checkbox" name="yarim_porsiyon" value="1" style="width: auto;"> Yarım (%60)
                    </label>
                  <% } %>
                  <button type="submit" class="dugme dugme-kucuk">Rezervasyon</button>
                </form>
              <% } else { %>
                <a href="/giris" class="dugme dugme-kucuk">Giriş Yap</a>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="kart" style="text-align: center; padding: 2rem;">
    <p>Bu yemekhane için önümüzdeki 7 günde planlanmış menü bulunamadı.</p>
  </div>
<% } %>

<%- include('../partials/footer') %>
