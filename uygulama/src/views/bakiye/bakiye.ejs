<%- include('../partials/header', { baslik: 'Bakiye İşlemleri' }) %>

<div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2rem;">
  <div class="kart" style="background: linear-gradient(135deg, var(--ana), var(--ana-koyu)); color: #fff;">
    <div style="font-size: 0.95rem; opacity: 0.9;">Kullanılabilir Güncel Bakiye</div>
    <div style="font-size: 2.5rem; font-weight: 700; margin: 0.5rem 0;">
      ₺<%= Number(bakiye).toFixed(2) %>
    </div>
    <div style="font-size: 0.8rem; opacity: 0.8;">
      * Bakiye bilgisi doğrudan birincil (Primary) veritabanından okunmaktadır.
    </div>
  </div>

  <div class="kart">
    <div class="kart-baslik">
      <h2 style="font-size: 1.25rem; margin: 0;">Bakiye Yükleme</h2>
      <small style="color: var(--metin-soluk);">10 TL ile 1000 TL arası</small>
    </div>

    <form action="/bakiye/yukle" method="POST">
      <div style="margin-bottom: 1rem;">
        <label for="tutar">Yüklenecek Tutar (TL)</label>
        <input type="number" id="tutar" name="tutar" min="10" max="1000" step="5" value="50" required>
      </div>

      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
        <button type="button" class="dugme dugme-ikincil dugme-kucuk" onclick="document.getElementById('tutar').value=50">+50 TL</button>
        <button type="button" class="dugme dugme-ikincil dugme-kucuk" onclick="document.getElementById('tutar').value=100">+100 TL</button>
        <button type="button" class="dugme dugme-ikincil dugme-kucuk" onclick="document.getElementById('tutar').value=200">+200 TL</button>
        <button type="button" class="dugme dugme-ikincil dugme-kucuk" onclick="document.getElementById('tutar').value=500">+500 TL</button>
      </div>

      <button type="submit" class="dugme" style="width: 100%;">Bakiyeyi Yükle (sp_bakiye_yukle)</button>
    </form>
  </div>
</div>

<div class="kart">
  <div class="kart-baslik">
    <h2 style="font-size: 1.25rem; margin: 0;">Bakiye Hareket Geçmişi</h2>
  </div>

  <% if (hareketler && hareketler.length > 0) { %>
    <div class="tablo-kaydir">
      <table class="duyarli-tablo">
        <thead>
          <tr>
            <th>Tarih / Saat</th>
            <th>İşlem Türü</th>
            <th>Açıklama</th>
            <th style="text-align: right;">Tutar</th>
          </tr>
        </thead>
        <tbody>
          <% hareketler.forEach(h => { %>
            <% const pozitif = Number(h.tutar) > 0; %>
            <tr>
              <td data-label="Tarih / Saat"><%= h.olusturma %></td>
              <td data-label="İşlem Türü">
                <% if (h.tur === 'yukleme') { %>
                  <span class="rozet rozet-kullanildi">Yükleme</span>
                <% } else if (h.tur === 'iade') { %>
                  <span class="rozet rozet-aktif">İade</span>
                <% } else { %>
                  <span class="rozet rozet-iptal">Rezervasyon</span>
                <% } %>
              </td>
              <td data-label="Açıklama" class="hucre-yigin"><%= h.aciklama || '—' %></td>
              <td data-label="Tutar" style="text-align: right; font-weight: 700; color: <%= pozitif ? 'var(--basari)' : 'var(--hata)' %>;">
                <%= pozitif ? '+' : '' %>₺<%= Number(h.tutar).toFixed(2) %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p style="color: var(--metin-soluk); text-align: center; padding: 1.5rem;">Henüz bakiye hareketi bulunmuyor.</p>
  <% } %>
</div>

<%- include('../partials/footer') %>
